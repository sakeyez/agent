KIMI_API_KEY=replace-with-your-moonshot-api-key
KIMI_MODEL=replace-with-a-kimi-model-id
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Optional model catalog. Without these values the legacy KIMI_MODEL is the only model.
# Entries use provider:model-id and may reference kimi or openai-compatible.
# AGENT_MODELS=kimi:kimi-k2,openai-compatible:qwen-coder
# AGENT_DEFAULT_MODEL=kimi:kimi-k2
# OPENAI_COMPAT_API_KEY=replace-with-compatible-api-key
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1

# Optional. Relative database paths are resolved from AGENT_WORKSPACE.
# AGENT_WORKSPACE=.
# AGENT_DB_PATH=.coding_agent/checkpoints.sqlite3
# AGENT_AUDIT_PATH=.coding_agent/audit.jsonl

# Optional context compaction. Values are approximate serialized character counts and turns.
# AGENT_CONTEXT_MAX_CHARS=80000
# AGENT_CONTEXT_KEEP_RECENT_TURNS=4
# AGENT_MEMORY_SUMMARY_MAX_CHARS=12000

# Optional local plugins. Loading plugins executes trusted Python from the workspace.
# AGENT_ENABLE_PLUGINS=false
# AGENT_PLUGINS_PATH=plugins
# AGENT_ENABLED_PLUGINS=my-plugin,another-plugin

# Optional MCP stdio servers. Configuration defaults to .coding_agent/mcp.json.
# AGENT_ENABLE_MCP=false
# AGENT_MCP_CONFIG_PATH=.coding_agent/mcp.json
